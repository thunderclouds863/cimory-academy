# Vercel container: Express (API + frontend). Database = Postgres eksternal (DATABASE_URL).
FROM node:22-bookworm-slim
WORKDIR /app
COPY backend/package*.json backend/
RUN cd backend && npm install --omit=dev --no-audit --no-fund
COPY backend backend
COPY frontend frontend
RUN cp backend/deploy/demo-banner.js frontend/demo-banner.js
ENV NODE_ENV=production PORT=80 UPLOAD_DIR=/tmp/uploads ADMIN_EMAIL=admin@demo.local ADMIN_PASSWORD=demo123
CMD ["bash", "backend/deploy/start-vercel.sh"]
