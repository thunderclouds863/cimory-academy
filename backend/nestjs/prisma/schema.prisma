generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model badges {
  id          String        @id @db.VarChar(40)
  emoji       String?       @db.VarChar(10)
  title       String
  descr       String?
  type        String        @db.VarChar(30)
  threshold   Int           @default(1)
  user_badges user_badges[]
}

model chapters {
  id          String    @id @db.VarChar(30)
  no          Int
  title       String
  description String?
  sort_order  Int       @default(0)
  created_at  DateTime  @default(now()) @db.Timestamptz(6)
  modules     modules[]
  quizzes     quizzes[]
}

model flashcards {
  id                   String                 @id @db.VarChar(30)
  emoji                String?                @db.VarChar(10)
  front                String
  back_json            Json
  sort_order           Int                    @default(0)
  user_flashcard_views user_flashcard_views[]
}

model leaderboard_config {
  period               String    @id @db.VarChar(7)
  ranking_type         String    @default("posttest") @db.VarChar(20)
  top_n                Int       @default(3)
  announcement         String?
  announcement_emoji   String?   @default("📢") @db.VarChar(10)
  announcement_title   String?
  created_at           DateTime  @default(now()) @db.Timestamptz(6)
  updated_at           DateTime  @default(now()) @db.Timestamptz(6)
  announcement_image   String?
  announcement_start   DateTime? @db.Timestamptz(6)
  announcement_end     DateTime? @db.Timestamptz(6)
  announcement_active  Boolean   @default(true)
  winners_popup_active Boolean   @default(true)
  winners_popup_start  DateTime? @db.Timestamptz(6)
  winners_popup_end    DateTime? @db.Timestamptz(6)

  @@index([period, announcement_active], map: "idx_config_announcement_active")
}

model leaderboard_prizes {
  id         Int      @id @default(autoincrement())
  period     String   @db.VarChar(7)
  rank       Int
  title      String
  prize      String
  emoji      String?  @default("🏆") @db.VarChar(10)
  created_at DateTime @default(now()) @db.Timestamptz(6)

  @@unique([period, rank])
  @@index([period], map: "idx_prizes_period")
}

model leaderboard_winners {
  id             Int      @id @default(autoincrement())
  period         String   @db.VarChar(7)
  rank           Int
  user_id        Int
  total_score    Int      @default(0)
  total_duration Int      @default(0)
  computed_at    DateTime @default(now()) @db.Timestamptz(6)
  prize_title    String?
  badge          String?  @db.VarChar(10)
  prize_emoji    String?  @default("🏆") @db.VarChar(10)
  prize_desc     String?
  users          users    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([period, rank])
  @@index([period], map: "idx_winners_period")
  @@index([period, rank], map: "idx_winners_period_rank")
  @@index([user_id], map: "idx_winners_user")
}

model modules {
  id                   String                 @id @db.VarChar(40)
  chapter_id           String                 @db.VarChar(30)
  no                   Int
  title                String
  duration             String?                @db.VarChar(20)
  video_path           String?
  summary              String?
  sort_order           Int                    @default(0)
  duration_sec         Int?
  chapters             chapters               @relation(fields: [chapter_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user_module_progress user_module_progress[]

  @@index([chapter_id], map: "idx_modules_chapter")
}

model monthly_quiz_attempts {
  id              Int             @id @default(autoincrement())
  monthly_id      Int
  user_id         Int
  correct         Int
  total           Int
  duration_sec    Int
  passed          Boolean         @default(false)
  created_at      DateTime        @default(now()) @db.Timestamptz(6)
  answers_json    Json?
  monthly_quizzes monthly_quizzes @relation(fields: [monthly_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users           users           @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([monthly_id, user_id])
  @@index([monthly_id], map: "idx_monthly_attempts")
}

model monthly_quiz_questions {
  id              Int             @id @default(autoincrement())
  monthly_id      Int
  q               String
  options_json    Json
  answer_idx      Int
  explain         String?
  sort_order      Int             @default(0)
  monthly_quizzes monthly_quizzes @relation(fields: [monthly_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([monthly_id], map: "idx_monthly_q_monthly")
}

model monthly_quizzes {
  id                     Int                      @id @default(autoincrement())
  month_key              String                   @unique @db.VarChar(7)
  title                  String
  description            String?
  min_score_pct          Int                      @default(60)
  time_limit_sec         Int                      @default(600)
  is_active              Boolean                  @default(true)
  created_at             DateTime                 @default(now()) @db.Timestamptz(6)
  monthly_quiz_attempts  monthly_quiz_attempts[]
  monthly_quiz_questions monthly_quiz_questions[]
}

model password_resets {
  id         Int       @id @default(autoincrement())
  user_id    Int
  token      String    @unique @db.VarChar(120)
  expires_at DateTime  @db.Timestamptz(6)
  used_at    DateTime? @db.Timestamptz(6)
  created_at DateTime  @default(now()) @db.Timestamptz(6)
  users      users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([token], map: "idx_pwreset_token")
}

model quiz_attempts {
  id           Int      @id @default(autoincrement())
  user_id      Int
  quiz_id      Int
  correct      Int
  total        Int
  duration_sec Int
  passed       Boolean  @default(false)
  created_at   DateTime @default(now()) @db.Timestamptz(6)
  quizzes      quizzes  @relation(fields: [quiz_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users        users    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([created_at], map: "idx_attempts_month")
  @@index([user_id], map: "idx_attempts_user")
  @@index([user_id, created_at(sort: Desc)], map: "idx_quiz_attempts_user_date")
}

model quiz_questions {
  id                     Int                      @id @default(autoincrement())
  quiz_id                Int
  q                      String
  options_json           Json
  answer_idx             Int
  explain                String?
  sort_order             Int                      @default(0)
  quizzes                quizzes                  @relation(fields: [quiz_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user_question_answered user_question_answered[]

  @@index([quiz_id], map: "idx_questions_quiz")
}

model quizzes {
  id             Int              @id @default(autoincrement())
  chapter_id     String           @db.VarChar(30)
  title          String
  min_score_pct  Int              @default(60)
  time_limit_sec Int              @default(300)
  quiz_attempts  quiz_attempts[]
  quiz_questions quiz_questions[]
  chapters       chapters         @relation(fields: [chapter_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model report_access {
  report_id                             Int
  user_id                               Int
  granted_at                            DateTime @default(now()) @db.Timestamptz(6)
  granted_by                            Int?
  users_report_access_granted_byTousers users?   @relation("report_access_granted_byTousers", fields: [granted_by], references: [id], onUpdate: NoAction)
  reports                               reports  @relation(fields: [report_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users_report_access_user_idTousers    users    @relation("report_access_user_idTousers", fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([report_id, user_id])
  @@index([user_id], map: "idx_report_access_user")
}

model report_views {
  id        Int      @id @default(autoincrement())
  report_id Int
  user_id   Int
  viewed_at DateTime @default(now()) @db.Timestamptz(6)
  reports   reports  @relation(fields: [report_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users     users    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([report_id], map: "idx_report_views_report")
  @@index([viewed_at(sort: Desc)], map: "idx_report_views_time")
  @@index([user_id], map: "idx_report_views_user")
}

model reports {
  id            Int             @id @default(autoincrement())
  slug          String          @unique @db.VarChar(80)
  title         String
  description   String?
  embed_url     String
  icon          String?         @default("📊") @db.VarChar(10)
  sort_order    Int             @default(0)
  is_active     Boolean         @default(true)
  created_by    Int?
  created_at    DateTime        @default(now()) @db.Timestamptz(6)
  updated_at    DateTime        @default(now()) @db.Timestamptz(6)
  report_access report_access[]
  report_views  report_views[]
  users         users?          @relation(fields: [created_by], references: [id], onUpdate: NoAction)

  @@index([is_active], map: "idx_reports_active")
  @@index([slug], map: "idx_reports_slug")
}

model user_badges {
  user_id   Int
  badge_id  String   @db.VarChar(40)
  earned_at DateTime @default(now()) @db.Timestamptz(6)
  badges    badges   @relation(fields: [badge_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users     users    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([user_id, badge_id])
}

model user_flashcard_views {
  user_id      Int
  flashcard_id String     @db.VarChar(30)
  seen_at      DateTime   @default(now()) @db.Timestamptz(6)
  flashcards   flashcards @relation(fields: [flashcard_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users        users      @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([user_id, flashcard_id])
}

model user_module_progress {
  user_id      Int
  module_id    String   @db.VarChar(40)
  completed_at DateTime @default(now()) @db.Timestamptz(6)
  modules      modules  @relation(fields: [module_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users        users    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([user_id, module_id])
}

model user_popup_seen {
  user_id   Int
  popup_key String   @db.VarChar(120)
  seen_at   DateTime @default(now()) @db.Timestamptz(6)
  users     users    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([user_id, popup_key])
  @@index([user_id], map: "idx_popup_seen_user")
}

model user_question_answered {
  user_id          Int
  question_id      Int
  first_correct_at DateTime       @default(now()) @db.Timestamptz(6)
  quiz_questions   quiz_questions @relation(fields: [question_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users            users          @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([user_id, question_id])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model users {
  id                                            Int                      @id @default(autoincrement())
  email                                         String                   @unique @db.VarChar(255)
  password_hash                                 String                   @db.VarChar(255)
  name                                          String                   @db.VarChar(120)
  role                                          String                   @default("user") @db.VarChar(20)
  xp                                            Int                      @default(0)
  streak                                        Int                      @default(0)
  last_active                                   DateTime?                @db.Date
  created_at                                    DateTime                 @default(now()) @db.Timestamptz(6)
  leaderboard_winners                           leaderboard_winners[]
  monthly_quiz_attempts                         monthly_quiz_attempts[]
  password_resets                               password_resets[]
  quiz_attempts                                 quiz_attempts[]
  report_access_report_access_granted_byTousers report_access[]          @relation("report_access_granted_byTousers")
  report_access_report_access_user_idTousers    report_access[]          @relation("report_access_user_idTousers")
  report_views                                  report_views[]
  reports                                       reports[]
  user_badges                                   user_badges[]
  user_flashcard_views                          user_flashcard_views[]
  user_module_progress                          user_module_progress[]
  user_popup_seen                               user_popup_seen[]
  user_question_answered                        user_question_answered[]
}
